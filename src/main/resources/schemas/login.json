{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "required": [
    "token",
    "tipo",
    "email",
    "role"
  ],
  "properties": {
    "token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "Bearer"
      ]
    },
    "email": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "enum": [
        "ADMIN",
        "EMPRESA",
        "AUDITOR"
      ]
    }
  },
  "additionalProperties": false
}
