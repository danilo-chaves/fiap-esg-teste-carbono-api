{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "required": [
    "agendamentoId",
    "titulo",
    "metaReducaoTco2e",
    "totalEmitidoEmpresa",
    "percentualImpacto",
    "dataFimPrevista",
    "status"
  ],
  "properties": {
    "agendamentoId": {
      "type": "integer",
      "minimum": 1
    },
    "titulo": {
      "type": "string",
      "minLength": 1
    },
    "metaReducaoTco2e": {
      "type": "number",
      "minimum": 0
    },
    "totalEmitidoEmpresa": {
      "type": "number",
      "minimum": 0
    },
    "percentualImpacto": {
      "type": "number",
      "minimum": 0
    },
    "dataFimPrevista": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDENTE",
        "EM_ANDAMENTO",
        "CONCLUIDO",
        "CANCELADO"
      ]
    }
  },
  "additionalProperties": false
}
